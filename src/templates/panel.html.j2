<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ country_label }} — Market Breadth Terminal</title>
<link rel="stylesheet" href="{{ asset_prefix }}dashboard.css">
<style>
/* Single-panel embed pages are meant to sit inside a small Notion embed
   block, not a full browser window — trim the chrome accordingly. */
body { margin: 0; }
header { padding: 10px 14px; }
header h1 { font-size: 14px; }
/* Embeds should use the frame they are given — no centred max-width column,
   which just produces large empty margins inside a wide Notion block. */
main { padding: 12px; max-width: none; margin: 0; }
section { margin-bottom: 0; }
footer { display: none; }
</style>
</head>
<body>

<header>
  <h1>{{ title }}</h1>
  <div class="header-controls">
    {%- if country_links | length > 1 %}
    <span class="country-switch">
      {%- for c in country_links %}
      <a href="{{ c.href }}" title="{{ c.title }}"{% if c.active %} class="active"{% endif %}>{{ c.label }}</a>
      {%- endfor %}
    </span>
    {%- endif %}
    <span class="generated-at">Updated {{ generated_at }} UTC</span>
    <button class="icon-btn" id="theme-toggle" title="Toggle dark/light">&#9788;</button>
  </div>
</header>

<main>
{{ body_html | safe }}
</main>

{% if needs_chartjs %}<script src="{{ asset_prefix }}vendor/chart.umd.min.js"></script>{% endif %}
{% if needs_lightweight %}<script src="{{ asset_prefix }}vendor/lightweight-charts.js"></script>{% endif %}
<script id="dashboard-data" type="application/json">{{ data_json }}</script>
<script src="{{ asset_prefix }}dashboard.js"></script>
</body>
</html>
