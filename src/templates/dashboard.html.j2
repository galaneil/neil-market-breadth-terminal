<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Market Breadth Terminal</title>
<style>
:root {
  --bg: #f5f6f8;
  --panel-bg: #ffffff;
  --text: #1a1d24;
  --text-dim: #6b7280;
  --border: #e2e5ea;
  --accent: #2563eb;
  --up: #16a34a;
  --down: #dc2626;
  --flat: #6b7280;
  --grid-line: #eef0f3;
}
:root[data-theme="dark"] {
  --bg: #10131a;
  --panel-bg: #171b24;
  --text: #e7e9ee;
  --text-dim: #9096a3;
  --border: #262b36;
  --accent: #5b9dff;
  --up: #2ecc71;
  --down: #f0554b;
  --flat: #9096a3;
  --grid-line: #232733;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #10131a;
    --panel-bg: #171b24;
    --text: #e7e9ee;
    --text-dim: #9096a3;
    --border: #262b36;
    --accent: #5b9dff;
    --up: #2ecc71;
    --down: #f0554b;
    --flat: #9096a3;
    --grid-line: #232733;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 14px;
  line-height: 1.4;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 10px;
}
header h1 { font-size: 18px; margin: 0; }
.header-controls { display: flex; align-items: center; gap: 12px; }
.generated-at { color: var(--text-dim); font-size: 12px; }
select, button.icon-btn {
  background: var(--panel-bg);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 13px;
  cursor: pointer;
}
main { padding: 20px; max-width: 1400px; margin: 0 auto; }
section { margin-bottom: 32px; }
section h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-dim); margin: 0 0 12px; }
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
}
.card {
  background: var(--panel-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 16px;
  overflow: hidden;
}
.card-title { font-size: 13px; color: var(--text-dim); margin-bottom: 4px; }
.card-value { font-size: 26px; font-weight: 600; margin-bottom: 2px; }
.card-value.up { color: var(--up); }
.card-value.down { color: var(--down); }
.card-sub { font-size: 12px; color: var(--text-dim); margin-bottom: 8px; }
.badge-row { display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }
.badge {
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--text-dim);
}
.badge.on.up { color: var(--up); border-color: var(--up); }
.badge.on.down { color: var(--down); border-color: var(--down); }
.tf-toggle { display: flex; gap: 4px; margin-bottom: 8px; flex-wrap: wrap; }
.tf-btn {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 5px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-dim);
  cursor: pointer;
}
.tf-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.chart-wrap { position: relative; height: 140px; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: right; padding: 7px 10px; border-bottom: 1px solid var(--border); }
th:first-child, td:first-child { text-align: left; }
th { color: var(--text-dim); font-weight: 500; cursor: pointer; user-select: none; }
tbody tr { cursor: pointer; }
tbody tr:hover { background: var(--grid-line); }
tbody tr.selected { background: var(--grid-line); outline: 1px solid var(--accent); }
.pct.up { color: var(--up); }
.pct.down { color: var(--down); }
.rank-cell { color: var(--text-dim); }
.table-wrap { background: var(--panel-bg); border: 1px solid var(--border); border-radius: 10px; padding: 4px 12px; max-height: 420px; overflow-y: auto; }
.drilldown {
  margin-top: 14px;
  background: var(--panel-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 16px;
  display: none;
}
.drilldown.visible { display: block; }
.drilldown-title { font-size: 13px; color: var(--text-dim); margin-bottom: 8px; }
.drilldown .chart-wrap { height: 220px; }
.empty-note { color: var(--text-dim); font-size: 12px; padding: 8px 0; }
footer { text-align: center; color: var(--text-dim); font-size: 11px; padding: 24px 0; }
</style>
</head>
<body>

<header>
  <h1>Market Breadth Terminal</h1>
  <div class="header-controls">
    <span class="generated-at">Updated {{ generated_at }} UTC</span>
    <select id="country-select">
      <option value="US">United States</option>
    </select>
    <button class="icon-btn" id="theme-toggle" title="Toggle dark/light">&#9788;</button>
  </div>
</header>

<main>
  <section id="panel-indices">
    <h2>Index Status</h2>
    <div class="card-grid" id="indices-grid"></div>
  </section>

  <section id="panel-sectors">
    <h2>Sector Performance</h2>
    <div class="table-wrap">
      <table id="sector-table">
        <thead><tr>
          <th data-sort="sector">Sector</th>
          <th data-sort="chg_1d">1D %</th>
          <th data-sort="chg_5d">5D %</th>
          <th data-sort="chg_20d">20D %</th>
          <th data-sort="rank">Rank</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="drilldown" id="sector-drilldown">
      <div class="drilldown-title"></div>
      <div class="tf-toggle" data-target="sector-drilldown"></div>
      <div class="chart-wrap"><canvas id="sector-drilldown-canvas"></canvas></div>
    </div>
  </section>

  <section id="panel-industries">
    <h2>Industry Performance</h2>
    <div class="table-wrap">
      <table id="industry-table">
        <thead><tr>
          <th data-sort="industry">Industry</th>
          <th data-sort="chg_1d">1D %</th>
          <th data-sort="chg_5d">5D %</th>
          <th data-sort="chg_20d">20D %</th>
          <th data-sort="rank">Rank</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="drilldown" id="industry-drilldown">
      <div class="drilldown-title"></div>
      <div class="tf-toggle" data-target="industry-drilldown"></div>
      <div class="chart-wrap"><canvas id="industry-drilldown-canvas"></canvas></div>
    </div>
  </section>

  <section id="panel-breadth">
    <h2>Breadth Internals</h2>
    <div class="card-grid" id="breadth-grid"></div>
  </section>
</main>

<footer>US equities &middot; data from Financial Modeling Prep &amp; TradingView &middot; refreshed daily after market close</footer>

<script src="vendor/chart.umd.min.js"></script>
<script id="dashboard-data" type="application/json">{{ data_json }}</script>
<script src="dashboard.js"></script>
</body>
</html>
