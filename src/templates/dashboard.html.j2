<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ country_label }} — Market Breadth Terminal</title>
<link rel="stylesheet" href="{{ asset_prefix }}dashboard.css">
</head>
<body>

<header>
  <h1>{{ country_flag | safe }}Market Breadth Terminal <span class="country-tag">{{ country_label }}</span></h1>
  <div class="header-controls">
    <span class="generated-at">Updated {{ generated_at }} UTC</span>
    {%- if country_links | length > 1 %}
    <span class="country-switch">
      {%- for c in country_links %}
      <a href="{{ c.href }}" title="{{ c.title }}"{% if c.active %} class="active"{% endif %}>{{ c.flag | safe }}{{ c.label }}</a>
      {%- endfor %}
    </span>
    {%- endif %}
    <button class="icon-btn" id="theme-toggle" title="Toggle dark/light">&#9788;</button>
  </div>
</header>

<main>
  <section id="panel-summary">
    <h2>Market Environment</h2>
    <div id="environment-panel"></div>
  </section>

  <section id="panel-indices">
    <h2>Index Status</h2>
    <div class="card-grid" id="indices-grid" data-keys="{{ index_keys_csv }}"></div>
  </section>

  <section id="panel-sectors">
    <h2>Sector Performance</h2>
    <div class="empty-note">Ranked by 20-trading-day performance (smoother than 1-day, which whipsaws on noise) — click a column to sort by it instead.</div>
    <div class="table-wrap">
      <table id="sector-table">
        <thead><tr>
          <th data-sort="sector">Sector</th>
          <th data-sort="chg_1d">1D %</th>
          <th data-sort="chg_5d">5D %</th>
          <th data-sort="chg_20d">20D %</th>
          <th data-sort="rank">Rank</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="drilldown" id="sector-drilldown">
      <div class="drilldown-title"></div>
      <div class="tf-toggle" data-target="sector-drilldown"></div>
      <div class="chart-wrap"><canvas id="sector-drilldown-canvas"></canvas></div>
    </div>
  </section>

  <section id="panel-industries">
    <h2>Industry Performance</h2>
    <div class="empty-note">Ranked by 20-trading-day performance (smoother than 1-day, which whipsaws on noise) — click a column to sort by it instead.</div>
    <div class="table-wrap">
      <table id="industry-table">
        <thead><tr>
          <th data-sort="industry">Industry</th>
          <th data-sort="chg_1d">1D %</th>
          <th data-sort="chg_5d">5D %</th>
          <th data-sort="chg_20d">20D %</th>
          <th data-sort="rank">Rank</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="drilldown" id="industry-drilldown">
      <div class="drilldown-title"></div>
      <div class="tf-toggle" data-target="industry-drilldown"></div>
      <div class="chart-wrap"><canvas id="industry-drilldown-canvas"></canvas></div>
    </div>
  </section>

  <section id="panel-breadth">
    <h2>Breadth Internals</h2>
    <div class="card-grid" id="breadth-grid" data-keys="breadth_adv_decl,breadth_new_hilo,breadth_hilo_counts,breadth_pct_up20,breadth_pct_up30,breadth_pct_down20,breadth_pct_down30"></div>
  </section>
</main>

<footer>US equities &middot; data from Financial Modeling Prep &amp; TradingView &middot; refreshed daily after market close</footer>

<script src="{{ asset_prefix }}vendor/chart.umd.min.js"></script>
<script src="{{ asset_prefix }}vendor/lightweight-charts.js"></script>
<script id="dashboard-data" type="application/json">{{ data_json }}</script>
<script src="{{ asset_prefix }}dashboard.js"></script>
</body>
</html>
